# Extension API Configuration
EXTENSION_API_KEY=<api_key>           # Your API key for accessing the extension service
EXTENSION_API_SECRET=<api_secret>     # Your API secret for authenticating requests
EXTENSION_BASE_URL=<base_url>         # Base URL for the extension API (e.g., https://your-app.onrender.com)

# Server Configuration
BACKEND_PORT=10000                    # Port number for the backend server (use 10000 for Render)

# Optional Configurations
FP_API_DOMAIN=https://api.uat.fyndx1.de  # Fynd Platform API Domain for UAT
